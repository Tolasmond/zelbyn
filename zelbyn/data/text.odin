package data

import "base:runtime"
import "core:unicode/utf8"

// The encoding of a string's bytes. None is ASCII or UTF-8, whose bytes
// are kept as they are, so that the value is a view of the input; the
// others are decoded, into UTF-8 (decode_text).
Encoding :: enum u8 {
	None,
	UTF_16LE,
	UTF_16BE,
	UTF_32LE,
	UTF_32BE,
	ISO_8859_1,
	Windows_1251,
	Windows_1252,
	IBM437,
}

// The text of a string in encoding, bytes, as UTF-8, allocated with
// allocator, or for None, bytes themselves. A UTF-16 or UTF-32 sequence
// that is not a character is U+FFFD, as in WHATWG's decoders, which
// Kaitai's JavaScript runtime uses: an unpaired surrogate is one, and so
// are the bytes left at the end that make no code unit. A byte-order mark
// is kept, as in Kaitai's C++ and Python runtimes. Fails with Memory_Limit
// when allocator has no room for the text.
@(require_results)
decode_text :: proc(bytes: []byte, encoding: Encoding, allocator: runtime.Allocator) -> (string, Read_Error) {
	switch encoding {
	case .None:
		return string(bytes), .None
	case .UTF_16LE, .UTF_16BE:
		return decode_utf16(bytes, encoding == .UTF_16BE, allocator)
	case .UTF_32LE, .UTF_32BE:
		return decode_utf32(bytes, encoding == .UTF_32BE, allocator)
	case .ISO_8859_1:
		return decode_single_byte(bytes, nil, allocator)
	case .Windows_1251:
		return decode_single_byte(bytes, &WINDOWS_1251, allocator)
	case .Windows_1252:
		return decode_single_byte(bytes, &WINDOWS_1252, allocator)
	case .IBM437:
		return decode_single_byte(bytes, &IBM437, allocator)
	}
	unreachable()
}

// n bytes from allocator; Memory_Limit when it has no room for them.
@(private = "file", require_results)
text_buffer :: proc(n: int, allocator: runtime.Allocator) -> ([]byte, Read_Error) {
	out, err := make([]byte, n, allocator)
	return out, err == nil ? .None : .Memory_Limit
}

// Appends r to out at n, which has room for it, and returns the new n.
@(private = "file")
put_rune :: #force_inline proc(out: []byte, n: int, r: rune) -> int {
	encoded, width := utf8.encode_rune(r)
	copy(out[n:], encoded[:width])
	return n + width
}

@(private = "file")
decode_utf16 :: proc(bytes: []byte, big: bool, allocator: runtime.Allocator) -> (text: string, err: Read_Error) {
	unit :: proc(bytes: []byte, i: int, big: bool) -> rune {
		return big ? rune(bytes[i]) << 8 | rune(bytes[i + 1]) : rune(bytes[i + 1]) << 8 | rune(bytes[i])
	}
	// a unit takes at most 3 bytes, and a pair of them 4
	out := text_buffer(len(bytes) / 2 * 3 + 3, allocator) or_return
	n, i := 0, 0
	for i + 1 < len(bytes) {
		u := unit(bytes, i, big)
		i += 2
		switch {
		case u < 0xD800 || u > 0xDFFF:
			n = put_rune(out, n, u)
		case u <= 0xDBFF && i + 1 < len(bytes):
			// a high surrogate, which needs a low one
			v := unit(bytes, i, big)
			if v < 0xDC00 || v > 0xDFFF {
				n = put_rune(out, n, utf8.RUNE_ERROR)
				continue
			}
			i += 2
			n = put_rune(out, n, 0x10000 + (u - 0xD800) << 10 + (v - 0xDC00))
		case u <= 0xDBFF:
			// a high surrogate at the end, with any byte after it
			n = put_rune(out, n, utf8.RUNE_ERROR)
			i = len(bytes)
		case:
			n = put_rune(out, n, utf8.RUNE_ERROR)
		}
	}
	if i < len(bytes) do n = put_rune(out, n, utf8.RUNE_ERROR)
	return string(out[:n]), .None
}

@(private = "file")
decode_utf32 :: proc(bytes: []byte, big: bool, allocator: runtime.Allocator) -> (text: string, err: Read_Error) {
	out := text_buffer(len(bytes) + 3, allocator) or_return
	n, i := 0, 0
	for ; i + 3 < len(bytes); i += 4 {
		b := bytes[i:][:4]
		u := big ? u32(b[0]) << 24 | u32(b[1]) << 16 | u32(b[2]) << 8 | u32(b[3]) : u32(b[3]) << 24 | u32(b[2]) << 16 | u32(b[1]) << 8 | u32(b[0])
		n = put_rune(out, n, u > 0x10FFFF || (u >= 0xD800 && u <= 0xDFFF) ? utf8.RUNE_ERROR : rune(u))
	}
	if i < len(bytes) do n = put_rune(out, n, utf8.RUNE_ERROR)
	return string(out[:n]), .None
}

// A single-byte encoding: bytes below 0x80 are ASCII, and the others are
// those of high, or with none, ISO-8859-1's, their own values.
@(private = "file")
decode_single_byte :: proc(bytes: []byte, high: ^[128]u16, allocator: runtime.Allocator) -> (text: string, err: Read_Error) {
	out := text_buffer(3 * len(bytes), allocator) or_return
	n := 0
	for b in bytes {
		r := rune(b)
		if b >= 0x80 && high != nil do r = rune(high[b - 0x80])
		n = put_rune(out, n, r)
	}
	return string(out[:n]), .None
}

// The characters of bytes 0x80 to 0xFF. windows-1251 and windows-1252 are
// WHATWG's, which give the bytes that the code pages leave undefined their
// own values, as C1 controls; IBM437 is Python's cp437.
